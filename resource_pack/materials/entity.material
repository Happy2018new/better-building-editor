{
  "materials": {
    "version": "1.0.0",
    "netease_block_as_entity_transparency": {
      "fragmentShader": "shaders/glsl/modern_projection_native_actor.fragment"
    },
    "sign:entity_static": {
      "vertexShader": "shaders/glsl/modern_projection_sign_body.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_sign_body.fragment",
      "+states": ["Blending"],
      "blendSrc": "SourceAlpha", "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_staff_gem:entity_alphatest": {
      "vertexShader": "shaders/glsl/modern_projection_staff.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_staff.fragment"
    },
    "modern_projection_staff_gem_violet:modern_projection_staff_gem": {
      "+defines": ["STAFF_VIOLET"]
    },
    "modern_projection_staff_grip:modern_projection_staff_gem": {
      "+defines": ["STAFF_GRIP"]
    },
    "modern_projection_staff_grip_violet:modern_projection_staff_grip": {
      "+defines": ["STAFF_VIOLET"]
    },
    "modern_projection_staff_motes:modern_projection_staff_gem": {
      "+defines": ["STAFF_GOLD_MOTE"]
    },
    "modern_projection_staff_aura:entity_static": {
      "vertexShader": "shaders/glsl/modern_projection_aura.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_aura.fragment",
      "+states": ["Blending", "DisableCulling"],
      "blendSrc": "SourceAlpha", "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_staff_aura_glow:modern_projection_staff_aura": {
      "+defines": ["AURA_GLOW"],
      "+states": ["DisableDepthWrite"],
      "blendSrc": "SourceAlpha", "blendDst": "One"
    },
    "modern_projection_survey_wire:entity_static": {
      "vertexShader": "shaders/glsl/modern_projection_outline.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_luminous_outline.fragment",
      "+defines": ["LUMINOUS_OUTLINE"],
      "+states": ["DisableCulling"]
    },
    "modern_projection_survey_guide:entity_static": {
      "vertexShader": "shaders/glsl/modern_projection_survey_stars.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_survey_stars.fragment",
      "+defines": ["SURVEY_GUIDE"],
      "+states": ["Blending", "DisableDepthWrite", "DisableCulling"],
      "blendSrc": "SourceAlpha", "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_survey_stars:entity_static": {
      "vertexShader": "shaders/glsl/modern_projection_survey_stars.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_survey_stars.fragment",
      "+states": ["Blending", "DisableCulling"],
      "blendSrc": "SourceAlpha", "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_survey_strike:modern_projection_survey_stars": {
      "+defines": ["SURVEY_STRIKE"]
    },
    "modern_projection_survey_glow:modern_projection_survey_stars": {
      "+defines": ["SURVEY_GLOW"],
      "+states": ["DisableDepthWrite"],
      "blendSrc": "SourceAlpha", "blendDst": "One"
    },
    "modern_projection_survey_strike_glow:modern_projection_survey_glow": {
      "+defines": ["SURVEY_STRIKE"]
    },
    "modern_projection_outline:entity_static": {
      "vertexShader": "shaders/glsl/modern_projection_outline.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_outline.fragment",
      "+states": ["DisableCulling"]
    },
    "modern_projection_liquid_still_water_grey:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_still_water_grey.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_still_water_grey_world:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid_world.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_still_water_grey.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_still_water_grey_frozen:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_still_water_grey_frozen.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_still_water_grey_frozen_world:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid_world.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_still_water_grey_frozen.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_flowing_water_grey:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_flowing_water_grey.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_flowing_water_grey_world:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid_world.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_flowing_water_grey.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_flowing_water_grey_frozen:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_flowing_water_grey_frozen.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    },
    "modern_projection_liquid_flowing_water_grey_frozen_world:entity_for_skeleton_alpha": {
      "vertexShader": "shaders/glsl/modern_projection_liquid_world.vertex",
      "fragmentShader": "shaders/glsl/modern_projection_liquid_flowing_water_grey_frozen.fragment",
      "+states": [
        "Blending",
        "DisableDepthWrite",
        "DisableCulling"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha"
    }
  }
}
