          ]
        }
      },
      {
        "p5": {
          "type": "image",
          "texture": "textures/modern_projection/rounded",
          "bilinear": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "keep_ratio": false,
          "layer": "$mp_patch_layer",
          "uv": [
            40,
