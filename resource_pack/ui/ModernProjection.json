  "input_background": {
    "type": "image",
    "texture": "textures/modern_projection/input_bg",
    "size": [
      "100%",
      "100%"
    ],
    "keep_ratio": false,
    "nineslice_size": [
      4,
      4,
      4,
      4
    ],
    "bilinear": true
  },
  "input_hover@ModernProjection.input_background": {
    "texture": "textures/modern_projection/input_hover"
  },
  "input@PyreactBase.input": {
    "$text_background_default": "ModernProjection.invisible",
    "$text_background_hover": "ModernProjection.invisible",
    "$edit_box_default_texture": "textures/modern_projection/transparent",
    "$edit_box_hover_texture": "textures/modern_projection/transparent",
    "$font_scale_factor": 1.0,
    "$text_edit_clipping_panel_size": [
      "100%",
      "100% + 4px"
    ],
    "$place_holder_text": "",
    "$text_box_text_color": [
      0.07,
      0.12,
      0.2
    ],
    "controls": [
      {
        "centering_panel": {
          "type": "panel",
          "size": [
            "100%",
            "100% - 4px"
          ],
          "controls": [
            {
              "clipper_panel": {
                "type": "panel",
                "size": "$text_edit_clipping_panel_size",
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "clips_children": true,
                "controls": [
                  {
                    "display_text@common.text_edit_box_label": {
                      "layer": 1,
                      "size": [
                        "default",
                        "default"
                      ],
                      "min_size": [
                        "100% - 6px",
                        0
                      ],
                      "offset": [
                        -3,
                        0
                      ],
                      "anchor_from": "right_middle",
                      "anchor_to": "right_middle",
                      "locked_color": [
                        0.95,
                        0.96,
                        0.98
                      ],
                      "locked_alpha": 1.0,
                      "bindings": [
                        {
                          "binding_type": "$text_edit_box_content_binding_type",
                          "binding_condition": "$text_edit_box_binding_condition",
                          "binding_collection_name": "$text_edit_box_grid_collection_name",
                          "binding_name": "$text_edit_box_content_binding_name",
                          "binding_name_override": "#item_name"
                        },
                        {
                          "binding_type": "$text_color_binding_type",
                          "binding_name": "$text_color_binding_name",
                          "binding_name_override": "#color"
                        },
                        {
                          "binding_name": "#newline_refresh"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not #text_edit_selected)",
                          "target_property_name": "#enabled"
                        }
                      ]
                    }
                  },
                  {
                    "visibility_panel": {
                      "type": "panel",
                      "controls": [
                        {
                          "place_holder_control@common.text_edit_box_place_holder_label": {
                            "layer": 1,
                            "size": [
                              "default",
                              "default"
                            ],
                            "min_size": [
                              "100% - 6px",
                              0
                            ],
                            "offset": [
                              -3,
                              0
                            ],
                            "anchor_from": "right_middle",
                            "anchor_to": "right_middle"
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "display_text",
                          "source_property_name": "(#item_name = '')",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": true
                        }
                      ]
                    }
                  },
                  {
                    "active_background@ModernProjection.round": {
                      "layer": 0,
                      "$mp_patch_layer": 0,
                      "size": [
                        "100%",
                        "100%"
                      ],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "display_text",
                          "resolve_sibling_scope": true,
                          "source_property_name": "#text_edit_selected",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "default@ModernProjection.invisible": {}
      },
      {
        "hover@ModernProjection.invisible": {}
      },
      {
        "pressed@ModernProjection.invisible": {}
      },
      {
        "locked@ModernProjection.invisible": {}
      }
    ]
  },
  "invisible": {
    "type": "image",
    "texture": "textures/modern_projection/transparent",
    "size": [
      "100%",
      "100%"
    ],
    "alpha": 0
  },
  "scroll_thumb": {
    "type": "image",
    "texture": "textures/ui/white",
    "size": [
      2,
      "100%"
    ],
    "color": [
      0.65,
      0.73,
      0.85
    ],
    "layer": 4
  },
  "scroll@PyreactBase.scrollBase": {
    "$scroll_size": [
      3,
      "100%"
    ],
    "$scroll_track_image_control": "common.empty_panel",
    "$scroll_box_visible": false,
    "$scroll_box_visible_touch": false,
    "$scroll_box_mouse_image_control": "ModernProjection.invisible",
    "$scroll_box_touch_image_control": "ModernProjection.invisible"
  },
  "slider_bar_default": {
    "type": "image",
    "texture": "textures/modern_projection/transparent",
    "controls": [
      {
        "sizing_panel": {
          "type": "panel",
          "controls": [
            {
              "slider_background@ModernProjection.invisible": {}
            },
            {
              "slider_progress@ModernProjection.invisible": {}
            }
          ]
        }
      }
    ]
  },
  "slider_bar_hover": {
    "type": "image",
    "texture": "textures/modern_projection/transparent",
    "controls": [
      {
        "sizing_panel": {
          "type": "panel",
          "controls": [
            {
              "slider_background_hover@ModernProjection.invisible": {}
            },
            {
              "slider_progress_hover@ModernProjection.invisible": {}
            }
          ]
        }
      }
    ]
  },
  "slider@PyreactBase.slider": {
    "$slider_box_size": [
      4,
      10
    ],
    "$background_default_control": "ModernProjection.invisible",
    "$progress_default_control": "ModernProjection.invisible",
    "$background_hover_control": "ModernProjection.invisible",
    "$progress_hover_control": "ModernProjection.invisible",
    "$slider_box_layout": "common.empty_panel",
    "$slider_box_hover_layout": "common.empty_panel",
    "$slider_box_locked_layout": "common.empty_panel",
    "$slider_box_indent_layout": "common.empty_panel",
    "controls": [
      {
        "slider_box@common.slider_box": {
          "$slider_box_layout": "$slider_box_layout",
          "$slider_box_size": "$slider_box_size",
          "$slider_track_button": "$slider_name"
        }
      },
      {
        "slider_bar_default@ModernProjection.slider_bar_default": {}
      },
      {
        "slider_bar_hover@ModernProjection.slider_bar_hover": {
          "visible": false
        }
      }
    ]
  }
}
