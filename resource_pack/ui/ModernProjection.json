{
  "namespace": "ModernProjection",
  "label@PyreactBase.label": {
    "font_type": "smooth",
    "backup_font_type": "smooth"
  },
  "type_image@PyreactBase.image": {
    "bilinear": true
  },
  "pointer@PyreactBase.button": {
    "button_mappings": [],
    "is_handle_button_move_event": true
  },
  "doll@PyreactBase.paperDoll": {
    "rotation": "none",
    "enable_scissor_test": true
  },
  "click_observer@PyreactBase.panel": {
    "type": "input_panel",
    "consume_hover_events": false,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "#modern_projection_pointer_down",
        "mapping_type": "global",
        "consume_event": false
      }
    ]
  },
  "round@PyreactBase.panel": {
    "$mp_patch_layer|default": 2,
    "controls": [
      {
        "p0": {
          "type": "image",
          "texture": "textures/modern_projection/rounded",
          "bilinear": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "keep_ratio": false,
          "layer": "$mp_patch_layer",
          "uv": [
            0,
            0
          ],
          "uv_size": [
            24,
            24
          ],
          "size": [
            0,
            0
          ]
        }
      },
      {
        "p1": {
          "type": "image",
          "texture": "textures/modern_projection/rounded",
          "bilinear": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "keep_ratio": false,
          "layer": "$mp_patch_layer",
          "uv": [
            24,
