{
  "namespace": "ModernProjectionTools",
  "hudScreen@common.base_screen": {
    "$screen_content": "ModernProjectionTools.hudContent"
  },
  "hudContent": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "open_button@common.button": {
          "$pressed_button_name": "button.focus_filler",
          "$focus_enabled": false,
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [-32, -68],
          "size": [
            118,
            30
          ],
          "visible": false,
          "layer": 5,
          "controls": [
            {
              "default": {
                "type": "image",
                "texture": "textures/ui/NormalButtonStroke",
                "layer": 1,
                "size": [
                  "100%",
                  "100%"
                ],
                "keep_ratio": false
              }
            },
            {
              "hover": {
                "type": "image",
                "texture": "textures/ui/NormalButtonStroke",
                "layer": 1,
                "size": [
                  "100%",
                  "100%"
                ],
                "keep_ratio": false
              }
            },
            {
              "pressed": {
                "type": "image",
                "texture": "textures/ui/NormalButtonNoStroke",
                "layer": 1,
                "size": [
                  "100%",
                  "100%"
                ],
                "keep_ratio": false
              }
            },
            {
              "caption": {
                "type": "label",
                "text": "投影工作台",
                "layer": 3,
                "color": [
                  1.0,
                  1.0,
                  1.0
                ],
                "text_alignment": "center",
                "anchor_from": "center",
                "anchor_to": "center",
                "size": [110, 20],
                "shadow": true
              }
            }
          ]
        }
      },
      {
        "tip_panel": {
          "type": "image",
          "texture": "textures/ui/hud_tip_text_background",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -32],
          "size": ["100%c + 14px", "100%c + 6px"],
          "alpha": 0.72,
          "visible": false,
          "layer": 7,
          "controls": [
            {
              "tip_text": {
                "type": "label",
                "text": "",
                "anchor_from": "center",
                "anchor_to": "center",
                "text_alignment": "center",
                "color": [1.0, 1.0, 1.0],
                "shadow": true,
                "layer": 8
              }
            }
          ]
        }
      },
      {
        "clear_button@common.button": {
          "$pressed_button_name": "button.focus_filler",
          "$focus_enabled": false,
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [74, -68],
          "size": [52, 30],
          "visible": false,
          "layer": 5,
          "controls": [
            {
              "default": {
                "type": "image",
                "texture": "textures/ui/NormalButtonStroke",
                "layer": 1,
                "size": ["100%", "100%"],
                "keep_ratio": false
              }
            },
            {
              "hover": {
                "type": "image",
                "texture": "textures/ui/NormalButtonStroke",
                "layer": 1,
                "size": ["100%", "100%"],
                "keep_ratio": false
              }
            },
            {
              "pressed": {
                "type": "image",
                "texture": "textures/ui/NormalButtonNoStroke",
                "layer": 1,
                "size": ["100%", "100%"],
                "keep_ratio": false
              }
            },
            {
              "caption": {
                "type": "label",
                "text": "清除",
                "layer": 3,
                "color": [1.0, 1.0, 1.0],
                "text_alignment": "center",
                "anchor_from": "center",
                "anchor_to": "center",
                "size": [48, 20],
                "shadow": true
              }
            }
          ]
        }
      }
    ]
  }
}
