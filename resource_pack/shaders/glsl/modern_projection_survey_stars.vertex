// __multiversion__
#include "entityVertexUtil.h"
uniform highp vec4 EXTRA_ACTOR_UNIFORM1;
uniform highp vec4 EXTRA_ACTOR_UNIFORM2;
uniform highp vec4 EXTRA_ACTOR_UNIFORM3;
varying highp vec2 starUV;
varying highp vec4 starTint;
varying highp float starGlint;
const float TAU = 6.28318530718;

void main() {
    // Bedrock may mirror the imported model axes. Decode the magnitude;
    // retain the sign only for the billboard corner, never for the slot id.
    vec2 address = floor((abs(POSITION.xy)+1.0)/4.0);
    float id = address.x+address.y*64.0;
    vec2 corner = (POSITION.xy-sign(POSITION.xy)*address*4.0)*2.0;
    float seed = fract(sin(id*91.31+17.17)*43758.5453);
    float spread = fract(sin(id*37.17+5.71)*17347.17);
    float phase = fract(sin(id*19.73+71.13)*31837.31);
    vec3 centre;
    vec3 tangent = vec3(1.,0.,0.);
    float stretch = 1.0;
    float visible = 1.0;
    float radius = .058 + seed*.032;
    starGlint = step(.98,spread);
    float clock = TIME * EXTRA_ACTOR_UNIFORM1.w;
#ifdef SURVEY_STRIKE
    float age = EXTRA_ACTOR_UNIFORM3.x;
    if (id < 192.0) {
        float tail = floor(id/3.0)/64.0;
        float path = clamp(age*1.45-tail*.42,0.,1.);
        float arc = mod(id,3.)*TAU/3. + seed*TAU;
        centre = vec3(-1.6+3.2*path,.65*sin(path*3.14159265),1.-2.*path);
        centre += vec3(0.,cos(arc),sin(arc))*(.03+tail*.25);
        visible = (1.-tail)*smoothstep(0.,.07,path)*(1.-smoothstep(.88,1.,path));
        radius *= 1.5;
    } else {
        float phi = id*2.39996323;
        float y = (id-192.)/64.-1.;
        vec3 direction = vec3(cos(phi)*sqrt(max(0.,1.-y*y)),y,sin(phi)*sqrt(max(0.,1.-y*y)));
        centre = direction*(.25+age*1.5);
        visible = smoothstep(.03,.15,age)*(1.-smoothstep(.35,1.,age));
    }
    visible *= 1.-smoothstep(.82,1.,age);
#else
    float edge = floor(id/256.);
    float slot = mod(id,256.);
    float axis = floor(edge/4.);
    float pair = mod(edge,4.);
    vec3 size = EXTRA_ACTOR_UNIFORM1.xyz;
    float length = axis < .5 ? size.x : (axis < 1.5 ? size.y : size.z);
    float count = min(224.,max(20.,length*14.));
    visible = 1.-step(count,slot);
    // Each small cohort smoothly chooses between drifting, streaming and
    // winding around the edge. Staggered phases avoid one synchronised pulse.
    float cycle = clock*TAU/21. + edge*.37 + floor(slot/16.)*.48;
    vec3 modes = max(vec3(0.),cos(vec3(cycle,cycle-TAU/3.,cycle-TAU*2./3.)));
    modes *= modes;
    modes /= max(.001,modes.x+modes.y+modes.z);
    // Whole cycles per engine clock wrap, at about 0.4 blocks/second.
    float loops = max(1.,floor(84./max(1.,length)+.5));
    float u = fract((slot+phase)/count + clock*loops/210.
                    + modes.x*.24*sin(clock*TAU/7.+seed*TAU)/max(1.,length));
    float angle = phase*TAU+clock*TAU/14.;
    float distance = .08 + .50*spread*spread;
    float a = (mod(pair,2.)*2.-1.);
    float b = (floor(pair/2.)*2.-1.);
    vec2 cloud = vec2(cos(angle),sin(angle))*distance;
    cloud += .17*vec2(sin(clock*TAU/7.+seed*TAU),cos(clock*TAU/10.+phase*TAU));
    vec2 stream = vec2(cos(phase*TAU),sin(phase*TAU))*(.07+spread*.16);
    stream += .06*vec2(sin(u*length*2.+clock*TAU/5.),cos(u*length*2.+clock*TAU/5.));
    float helix = u*length*TAU*.36-clock*TAU/5.+floor(slot/8.)*2.39996323;
    vec2 spiral = vec2(cos(helix),sin(helix))*(.18+spread*.30);
    vec2 drift = modes.x*cloud+modes.y*stream+modes.z*spiral;
    // Reserved tail slots provide one occasional comet per edge. Each has
    // eight progressively softer segments, separate from the stardust.
    if (slot >= 224.) {
        float comet = floor((slot-224.)/8.);
        float tail = mod(slot-224.,8.)/8.;
        float route = fract(comet*.249+edge*.137+clock*max(1.,floor(210./length+.5))/210.);
        u = route-tail*min(.75,length*.35)/length;
        float arc = route*length*2. + clock*TAU/7.+comet*TAU*.25;
        drift = vec2(cos(arc),sin(arc))*(.13+.06*comet);
        visible = (1.-step(1.,comet))*(1.-tail)*.6;
        // A single occasional comet, staggered across the twelve edges.
        visible *= smoothstep(.45,.7,.5+.5*sin(clock*TAU/14.+edge*1.7));
        radius = .06*(1.-tail*.5);
        stretch = 1.65;
        starGlint = 1.-step(.01,tail);
    }
    if (axis < .5) centre = vec3((u-.5)*size.x,a*size.y*.5+drift.x,b*size.z*.5+drift.y);
    else if (axis < 1.5) centre = vec3(a*size.x*.5+drift.x,(u-.5)*size.y,b*size.z*.5+drift.y);
    else centre = vec3(a*size.x*.5+drift.x,b*size.y*.5+drift.y,(u-.5)*size.z);
    tangent = axis < .5 ? vec3(1.,0.,0.) : (axis < 1.5 ? vec3(0.,1.,0.) : vec3(0.,0.,1.));
    visible *= .62+.25*pow(.5+.5*sin(clock*TAU/3.5+seed*TAU),2.);
    visible *= smoothstep(0.,.025,u)*(1.-smoothstep(.975,1.,u));
    radius += starGlint*.03;
#endif
    vec4 position = vec4(centre*16.,1.);
    vec4 direction = vec4(tangent*16.,0.);
#ifdef USE_SKINNING
    #ifdef NETEASE_SKINNING
        position = GetBoneMatForNetease(int(BONEID_0)) * position;
        direction = GetBoneMatForNetease(int(BONEID_0)) * direction;
    #elif defined(LARGE_VERTEX_SHADER_UNIFORMS)
        position = BONES[int(BONEID_0)] * position;
        direction = BONES[int(BONEID_0)] * direction;
    #else
        position = BONE * position;
        direction = BONE * direction;
    #endif
#endif
    vec4 worldPosition = WORLD * position;
    worldPosition.xyz += EXTRA_ACTOR_UNIFORM2.xyz;
    gl_Position = VIEWPROJ * worldPosition;
    // Avoid losing every dust mote to subpixel rasterization on big boxes.
    radius = max(radius,clamp(gl_Position.w*.004,0.,.6));
    // Add the projected view-space quad offset before perspective division.
    // This engine exposes WORLDVIEW/PROJ, but no standalone VIEW uniform.
    vec4 projectedDirection = VIEWPROJ * WORLD * direction;
    vec2 along = (projectedDirection.xy*gl_Position.w-gl_Position.xy*projectedDirection.w)
               /vec2(PROJ[0][0],PROJ[1][1]);
    along = dot(along,along) > .00001 ? normalize(along) : vec2(1.,0.);
    vec2 quad = along*corner.x*stretch + vec2(-along.y,along.x)*corner.y;
    gl_Position.xy += quad*radius*step(.001,visible)*vec2(PROJ[0][0],PROJ[1][1]);
    starUV = corner;
    vec3 tint = mix(vec3(.57,.69,.90),vec3(.87,.91,1.),seed);
    tint = mix(tint,vec3(.78,.66,.91),step(.86,phase));
    starTint = vec4(tint,visible);
}
