// __multiversion__
#include "entityVertexUtil.h"
uniform highp vec4 EXTRA_ACTOR_UNIFORM1;
uniform highp vec4 EXTRA_ACTOR_UNIFORM2;
uniform highp vec4 EXTRA_ACTOR_UNIFORM3;
uniform highp vec4 EXTRA_ACTOR_UNIFORM4;
varying highp vec2 effectUV;
varying highp vec4 effectTint;
varying highp float effectKind;
varying highp vec4 facetNormal;
varying highp vec4 facetView;
varying highp vec3 facetLight;
const float TAU=6.28318530718;
float random1(float p) { return fract(sin(p*12.9898+4.1414)*43758.5453); }
vec4 worldPoint(vec3 point,float w) {
    // Native entity bones invert model Y. All effect math is world-positive-up.
    vec4 p=vec4(point*vec3(16.,-16.,16.),w);
#ifdef USE_SKINNING
    #ifdef NETEASE_SKINNING
        p=GetBoneMatForNetease(int(BONEID_0))*p;
    #elif defined(LARGE_VERTEX_SHADER_UNIFORMS)
        p=BONES[int(BONEID_0)]*p;
    #else
        p=BONE*p;
    #endif
#endif
    p=WORLD*p;
    p.xyz+=EXTRA_ACTOR_UNIFORM2.xyz*w;
    return p;
}
vec4 projectPoint(vec3 point,float w) { return VIEWPROJ*worldPoint(point,w); }
vec3 localDirection(vec3 worldDirection) {
    // The native root also rotates X/Z. Convert camera/light directions with
    // the actual bone basis; copying world axes into model space reverses the
    // beam and anchors its star at the far corner for some camera headings.
    vec3 x=worldPoint(vec3(1.,0.,0.),0.).xyz;
    vec3 y=worldPoint(vec3(0.,1.,0.),0.).xyz;
    vec3 z=worldPoint(vec3(0.,0.,1.),0.).xyz;
    return vec3(dot(worldDirection,x)/dot(x,x),dot(worldDirection,y)/dot(y,y),dot(worldDirection,z)/dot(z,z));
}

// All animation lives on the GPU. Native TIME wraps at 210 s; route clocks
// use integral cycles so looping does not jump at the engine's wrap.
float cycles(float count,float speed){return floor(count*speed+.5)/210.;}
vec3 cubeCorner(float id){
 return vec3(mod(id,2.),mod(floor(id/2.),2.),floor(id/4.))*2.-1.;
}
vec3 edgePoint(float edge,float u){
 float axis=floor(edge/4.),pair=mod(edge,4.);
 float a=mod(pair,2.)*2.-1.,b=floor(pair/2.)*2.-1.;
 vec3 h=EXTRA_ACTOR_UNIFORM1.xyz*.5+vec3(.024);
 if(axis<.5)return vec3((u*2.-1.)*h.x,a*h.y,b*h.z);
 if(axis<1.5)return vec3(a*h.x,(u*2.-1.)*h.y,b*h.z);
 return vec3(a*h.x,b*h.y,(u*2.-1.)*h.z);
}
vec3 walkVertex(float i,float lane){
 i=mod(i,8.);float id=0.;
 if(i>.5)id=1.;if(i>1.5)id=5.;if(i>2.5)id=4.;if(i>3.5)id=6.;
 if(i>4.5)id=7.;if(i>5.5)id=3.;if(i>6.5)id=2.;
 vec3 p=cubeCorner(id);if(lane>.5&&lane<1.5)p=p.yzx;else if(lane>1.5)p=p.zxy;
 return p*(EXTRA_ACTOR_UNIFORM1.xyz*.5+vec3(.024));
}
void edgeFrame(float t,float lane,out vec3 point,out vec3 normal,out vec3 binormal){
 float u=fract(t)*8.,i=floor(u),f=fract(u),cut=.08;
 vec3 a=walkVertex(i,lane),b=walkVertex(i+1.,lane),tangent;
 if(f<cut||f>1.-cut){
  vec3 start,corner,end;
  float v;
  if(f<cut){start=mix(walkVertex(i-1.,lane),a,1.-cut);corner=a;end=mix(a,b,cut);v=(f+cut)/(2.*cut);}
  else{start=mix(a,b,1.-cut);corner=b;end=mix(b,walkVertex(i+2.,lane),cut);v=(f-1.+cut)/(2.*cut);}
  point=mix(mix(start,corner,v),mix(corner,end,v),v);
  tangent=normalize(mix(corner-start,end-corner,v));
 }else{point=mix(a,b,f);tangent=normalize(b-a);}
 normal=normalize(point-tangent*dot(point,tangent));binormal=normalize(cross(tangent,normal));
}
vec3 route(float t,float lane,float clock){
 vec3 p,n,b;edgeFrame(t,lane,p,n,b);
 float orbit=EXTRA_ACTOR_UNIFORM3.w;
 float angle=t*TAU*16.-clock*TAU*cycles(19.,orbit)+lane*2.1;
 float radius=clamp(min(EXTRA_ACTOR_UNIFORM1.x,min(EXTRA_ACTOR_UNIFORM1.y,EXTRA_ACTOR_UNIFORM1.z))*.05,.075,.65);
 return p+radius*(n*cos(angle)+b*sin(angle));
}
vec3 starRoute(float id,float clock){
 float u=fract(clock*cycles(4.+mod(id,3.),EXTRA_ACTOR_UNIFORM3.w)+random1(id+421.));
 return route(u,mod(id,3.),clock);
}
float starLight(float id){
 float a=.5+.5*sin(TIME*TAU*cycles(45.+mod(id,4.)*7.,EXTRA_ACTOR_UNIFORM3.w)+id*2.17);
 float b=pow(.5+.5*sin(TIME*TAU*cycles(107.+mod(id,4.)*10.,EXTRA_ACTOR_UNIFORM3.w)+id*4.13),12.);
 return clamp(.31+.58*pow(a,2.2)+b*.42,0.,1.);
}
vec3 shardVertex(float id,float seed){
 float wide=.34+seed*.35,thick=.17+random1(seed*63.+4.)*.28;
 if(id<.5)return vec3(.11,1.13,0.);
 if(id<1.5)return vec3(-.13,-.86,.07);
 if(id<2.5)return vec3(-wide,.12,-.04);
 if(id<3.5)return vec3(.08,-.06,thick);
 if(id<4.5)return vec3(wide,.04,.07);
 return vec3(-.03,.13,-thick);
}
vec3 tumble(vec3 p,float seed,float clock){
 float speed=EXTRA_ACTOR_UNIFORM3.w;
 float a=clock*TAU*cycles(11.+floor(seed*22.),speed)+seed*29.;
 float b=clock*TAU*cycles(9.+floor(random1(seed*80.+3.)*15.),speed)+seed*11.+sin(clock*TAU*cycles(13.,speed)+seed*17.)*.35;
 float c=sin(clock*TAU*cycles(8.,speed)+seed*31.)*.55+seed*7.;
 p.yz=mat2(cos(a),sin(a),-sin(a),cos(a))*p.yz;
 p.xz=mat2(cos(b),-sin(b),sin(b),cos(b))*p.xz;
 p.xy=mat2(cos(c),sin(c),-sin(c),cos(c))*p.xy;return p;
}
vec3 flake(float face,vec2 uv,float seed,float clock,out vec3 normal){
 float side=mod(face,4.);bool lower=face>3.5;
 vec3 a=shardVertex(lower?1.:0.,seed),b=shardVertex(2.+side,seed),c=shardVertex(2.+mod(side+1.,4.),seed);
 if(lower){vec3 swap=b;b=c;c=swap;}
 normal=normalize(cross(b-a,c-a));
 if(dot(normal,(a+b+c)/3.)<0.)normal=-normal;
 normal=tumble(normal,seed,clock);
 return tumble(uv.y>0.?a:(uv.x>0.?c:b),seed,clock);
}
vec3 markerNormal(){
 float face=EXTRA_ACTOR_UNIFORM4.w,axis=floor(face/2.),sign=mod(face,2.)*2.-1.;
 vec3 n=axis<.5?vec3(sign,0.,0.):axis<1.5?vec3(0.,sign,0.):vec3(0.,0.,sign);
 return normalize(localDirection(n));
}
vec3 markerPoint(vec3 n,float x,float y,float z){
 vec3 tangent=normalize(cross(abs(n.y)>.9?vec3(1.,0.,0.):vec3(0.,1.,0.),n));
 return n*(.55+z*.58)+tangent*x*.64+cross(n,tangent)*y*.64;
}
vec3 markerRoute(float lane,float clock){
 float a=clock*TAU*cycles(24.+lane*4.,EXTRA_ACTOR_UNIFORM3.w)+lane*TAU/3.;
 float r=.64+lane*.14+.055*sin(clock*TAU*cycles(20.,EXTRA_ACTOR_UNIFORM3.w)+lane);
 float entered=smoothstep(0.,.8,EXTRA_ACTOR_UNIFORM3.x);
 return markerPoint(markerNormal(),cos(a)*r*(.2+.8*entered),sin(a)*r*.83*(.2+.8*entered),.16+.09*sin(a*2.+lane));
}
varying highp vec3 materialPos;
void main(){
 vec2 address=floor((abs(POSITION.xy)+1.)/4.);float id=address.x+address.y*64.;
 vec2 corner=TEXCOORD_0*2.-1.;float seed=random1(id+1.),phase=random1(id+113.);
 vec3 size=EXTRA_ACTOR_UNIFORM1.xyz,camera=localDirection(EXTRA_ACTOR_UNIFORM4.xyz);
 float entered=EXTRA_ACTOR_UNIFORM3.x,brightness=EXTRA_ACTOR_UNIFORM3.y,orbit=EXTRA_ACTOR_UNIFORM3.w;
 float theme=floor(EXTRA_ACTOR_UNIFORM3.z),density=EXTRA_ACTOR_UNIFORM4.w;
 float scale=clamp(1.25*pow(min(size.x,min(size.y,size.z))/4.,.9),.82,16.);
 vec3 centre=vec3(0.),tangent=vec3(1.,0.,0.),tint=vec3(1.,.81,.44);
 float width=.018,opacity=1.;
 effectUV=corner;effectKind=0.;materialPos=vec3(0.);
 facetNormal=vec4(0.,1.,0.,seed);facetView=vec4(0.,0.,1.,theme);
 facetLight=normalize(localDirection(vec3(-.3,.8,.6)));
#if defined(SURVEY_GUIDE)
 float edge=floor(id/48.),u=(mod(id,48.)+(corner.x+1.)*.5)/48.;
 centre=edgePoint(edge,u);tangent=edgePoint(edge,1.)-edgePoint(edge,0.);
 materialPos=centre/(size*.5+vec3(.024));
 width=.011;opacity=smoothstep(0.,.85,entered)*.14;effectKind=7.;effectUV=vec2(u,corner.y);
#elif defined(SURVEY_STRIKE)
 vec3 n=markerNormal();float appear=smoothstep(0.,.08,entered);
 float flash=exp(-pow((entered-.15)*8.,2.));
 if(id<144.){
  float lane=floor(id/48.),t=(mod(id,48.)+(corner.x+1.)*.5)/48.;
  float clock=TIME-t*(1.1+lane*.2);
  centre=markerRoute(lane,clock);tangent=markerRoute(lane,clock+.008)-centre;
  width=.008+.010*(1.-t);opacity=pow(1.-t,1.65)*(.5+.5*starLight(lane+12.));
  effectKind=2.;effectUV=vec2(t,corner.y);
 }else if(id<147.){
  float lane=id-144.;centre=markerRoute(lane,TIME);
  width=.14+.075*starLight(lane+12.);opacity=.68+.32*starLight(lane+12.);effectKind=1.;
 }else if(id<149.){
  centre=markerPoint(n,0.,0.,0.);width=id<148.?.23+flash*.27:.28;
  opacity=id<148.?.7+flash*.3:.19;effectKind=id<148.?1.:0.;
 }else if(id<333.){
  float shard=floor((id-149.)/8.);seed=random1(shard+807.);phase=random1(shard+541.);
  float a=TIME*TAU*cycles(6.+floor(seed*10.),orbit)+seed*TAU;
  float r=(.43+phase*.72)*(.15+.85*smoothstep(0.,.9,entered));
  centre=markerPoint(n,cos(a)*r,sin(a)*r*.83,.18+seed*.18+.12*sin(a*2.+seed*5.));
  // Keep the permanent endpoint crystals readable at normal game scale.
  // Enlarge the silhouette and orbit while limiting near-camera angular size.
  float eyeDistance=length(camera-centre);
  float shardSize=min(.060+seed*.095,max(.002,eyeDistance*.035));
  vec3 normal;centre+=flake(mod(id-149.,8.),corner,seed,TIME,normal)*shardSize;
  facetNormal=vec4(normal,seed);facetView.xyz=normalize(camera-centre);effectKind=3.;opacity=.9*smoothstep(.15,.65,eyeDistance);
  effectUV=corner.y>0.?vec2(0.,1.):corner.x>0.?vec2(1.,0.):vec2(0.);
 }else if(id<413.){
  seed=random1(id+404.);float a=TIME*TAU*cycles(11.+floor(seed*10.),orbit)+seed*TAU;
  float r=(.22+random1(id+652.)*.85)*smoothstep(0.,.8,entered);
  centre=markerPoint(n,cos(a)*r,sin(a)*r*.83,.18+.12*sin(a*2.+seed));
  width=.012+seed*.018;opacity=.2+.48*pow(.5+.5*sin(TIME*TAU*cycles(60.,orbit)+seed*19.),3.);
  if(mod(id,11.)<.5){effectKind=1.;width*=2.;}
 }else{opacity=0.;}
 opacity*=appear;
#else
 if(id<432.){
  float star=floor(id/48.),t=(mod(id,48.)+(corner.x+1.)*.5)/48.;
  float clock=TIME-t*(2.7+random1(star+492.)*.8);
  centre=starRoute(star,clock);tangent=starRoute(star,clock+.008)-centre;
  width=(.008+.019*(1.-t))*scale;
  opacity=pow(1.-t,1.65)*(.42+.58*starLight(star));effectKind=2.;effectUV=vec2(t,corner.y);
 }else if(id<441.){
  float star=id-432.,light=starLight(star);centre=starRoute(star,TIME);
  width=(.17+light*.16)*scale;opacity=.48+light*.52;effectKind=1.;
 }else if(id<449.){
  centre=cubeCorner(id-441.)*(size*.5+vec3(.024));
  width=.065*scale;opacity=.23;effectKind=1.;
 }else if(id<2033.){
  float shard=floor((id-449.)/8.);seed=random1(shard+370.);phase=random1(shard+935.);
  float lane=mod(shard,3.),u=fract(phase+TIME*cycles(3.+floor(seed*3.),orbit));
  centre=route(u,lane,TIME);
  // The gold/starry projection uses the same geometry but a larger, clearly
  // faceted crystal envelope. Density controls how many exist, this factor
  // controls their readable size independently.
  // Cap angular size from the shared shard centre, so a large-box crystal
  // passing beside the eye cannot cover the scene. All eight faces use the
  // same scale/fade; the crystal never tears apart while crossing the eye.
  float eyeDistance=length(camera-centre);
  float shardSize=min((.055+pow(random1(shard+113.),1.5)*.095)*scale,max(.002,eyeDistance*.035));
  vec3 normal;centre+=flake(mod(id-449.,8.),corner,seed,TIME,normal)*shardSize;
  facetNormal=vec4(normal,seed);facetView.xyz=normalize(camera-centre);
  opacity=step(shard+.5,110.*density)*smoothstep(.15,.65,eyeDistance);effectKind=3.;
  effectUV=corner.y>0.?vec2(0.,1.):corner.x>0.?vec2(1.,0.):vec2(0.);
 }else if(id<2531.){
  float mote=id-2033.;seed=random1(mote+8.);phase=random1(mote+378.);
  float u=fract(phase+TIME*cycles(3.+floor(seed*3.),orbit));
  centre=route(u,mod(mote,3.),TIME);
  float a=TIME*TAU*cycles(7.,orbit)+seed*TAU;
  centre+=vec3(cos(a),sin(a),sin(a+seed))*.012*scale;
  width=(.009+seed*.013)*scale;
  opacity=(.22+.78*pow(.5+.5*sin(TIME*TAU*cycles(50.+floor(seed*20.),orbit)+mote*2.39),7.))*step(mote+.5,290.*density);
  if(mod(mote,23.)<.5){effectKind=1.;width*=4.;opacity=pow(opacity,3.);}
 }else if(id<2555.){
  // Small star glints are attached to actual rotating crystal facets. A fixed
  // virtual key light keeps them visible in daylight and at night; changing
  // view or tumble angle brings individual facets briefly into reflection.
  float shard=(id-2531.)*4.;seed=random1(shard+370.);phase=random1(shard+935.);
  float u=fract(phase+TIME*cycles(3.+floor(seed*3.),orbit));
  centre=route(u,mod(shard,3.),TIME);
  float eyeDistance=length(camera-centre);
  float shardSize=min((.055+pow(random1(shard+113.),1.5)*.095)*scale,max(.002,eyeDistance*.035));
  vec3 normal;
  vec3 tip=flake(mod(shard,8.),vec2(0.,1.),seed,TIME,normal)*shardSize;
  vec3 view=normalize(camera-centre);
  float reflected=pow(max(0.,dot(reflect(-facetLight,normal),view)),36.);
  centre+=tip;
  width=(.13+.16*reflected)*scale;
  opacity=reflected*step(shard+.5,110.*density)*smoothstep(.15,.65,eyeDistance);
  tint=vec3(1.,.98,.91);effectKind=1.;
 }else{opacity=0.;}
 opacity*=smoothstep(.06,.85,entered);
#endif
 gl_Position=projectPoint(centre,1.);
 if(effectKind<2.5||effectKind>5.5){
  if(effectKind<1.5){
   width=min(width,max(.001,abs(gl_Position.w)*.035));
   opacity*=smoothstep(.08,.35,length(camera-centre));
  }
  vec2 projectionScale=vec2(length(vec3(VIEWPROJ[0][0],VIEWPROJ[1][0],VIEWPROJ[2][0])),length(vec3(VIEWPROJ[0][1],VIEWPROJ[1][1],VIEWPROJ[2][1])));
  vec4 d=projectPoint(tangent,0.);vec2 along=(d.xy*gl_Position.w-gl_Position.xy*d.w)/projectionScale;
  along=dot(along,along)>.000001?normalize(along):vec2(1.,0.);vec2 quad=corner;
  if((effectKind>1.5&&effectKind<2.5)||effectKind>5.5){
   if(effectKind>5.5){
    // Keep a resolved core at distance and cap the near-camera halo. Without
    // this, the subpixel core flickers and an edge beside the eye fills the screen.
    float depth=max(.001,gl_Position.w);
    width=clamp(width,depth*.0006,depth*.009)*fract(EXTRA_ACTOR_UNIFORM3.z)*10.;
   }
   quad=vec2(-along.y,along.x)*corner.y;
  }
  gl_Position.xy+=quad*width*step(.0001,opacity)*projectionScale;
 }
 // Leave homogeneous near/far clipping to the rasterizer. Relocating only
 // the vertices behind the eye stretches crossing triangles across the view.
 effectTint=vec4(tint,opacity*brightness);
}
