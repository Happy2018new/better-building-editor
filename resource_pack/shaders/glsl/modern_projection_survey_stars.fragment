// __multiversion__
#include "fragmentVersionCentroid.h"
#include "uniformPerFrameConstants.h"
uniform highp vec4 EXTRA_ACTOR_UNIFORM1;
varying highp vec2 effectUV;
varying highp vec4 effectTint;
varying highp float effectKind;
varying highp vec4 facetNormal;
varying highp vec4 facetView;
varying highp vec3 facetLight;
varying highp vec3 materialPos;
varying highp float crystalBirth;
const float TAU=6.28318530718;
vec3 gold(float phase){
 float x=fract(phase)*5.;vec3 a=vec3(.722,.408,.098),b=vec3(.961,.682,.192);
 if(x>=1.){a=b;b=vec3(1.,.886,.557);}if(x>=2.){a=b;b=vec3(1.,.973,.843);}
 if(x>=3.){a=b;b=vec3(.929,.718,.286);}if(x>=4.){a=b;b=vec3(.722,.408,.098);}
 return mix(mix(a,b,smoothstep(0.,1.,fract(x))),vec3(1.,.855,.569),.26);
}
vec3 astral(float phase){
 return mix(vec3(.22,.74,.97),vec3(.72,.30,.94),.5+.5*sin(phase*TAU));
}
void main(){
 vec2 p=abs(effectUV);float alpha=1.,theme=facetView.w;vec3 rgb=effectTint.rgb;
 if(theme>.5)rgb=vec3(.52,.69,1.);
 if(effectKind<.5){
  float r2=dot(p,p),core=exp(-r2*38.);
  float halo=exp(-r2*7.)*(1.-smoothstep(.45,1.,r2));
  alpha=core*.9+halo*.18;
  rgb=mix(theme>.5?vec3(.24,.40,1.):vec3(1.,.48,.08),
          theme>.5?vec3(.85,.94,1.):vec3(1.,.97,.80),core);
 }else if(effectKind<1.5){
  float x=pow(1.-clamp(p.x,0.,1.),2.)*exp(-p.y*p.y/(.0002+.004*pow(1.-p.x,4.)));
  float y=pow(1.-clamp(p.y,0.,1.),2.2)*exp(-p.x*p.x/(.0002+.004*pow(1.-p.y,4.)));
  float core=exp(-dot(p,p)*280.);
  float rays=max(x,y);
  alpha=core*.9+rays*.55+exp(-dot(p,p)*15.)*.075;
  rgb=mix(theme>.5?vec3(.35,.52,1.):vec3(1.,.62,.16),
          theme>.5?vec3(.91,.97,1.):vec3(1.,.99,.90),clamp(core+rays,0.,1.));
 }else if(effectKind<2.5){
  float filament=exp(-p.y*p.y*110.);
  // A fine light core with a faint halo, smoothly vanishing at the tail.
  float head=1.-smoothstep(.05,1.,effectUV.x);
  alpha=(filament*.62+exp(-p.y*p.y*8.)*.10)*head;
  rgb=mix(theme>.5?vec3(.25,.32,.90):vec3(1.,.43,.06),
          theme>.5?vec3(.83,.94,1.):vec3(1.,.98,.83),filament*head);
 }else if(effectKind<3.5){
  vec3 n=normalize(facetNormal.xyz),v=normalize(facetView.xyz),light=normalize(facetLight);
  float facing=abs(dot(n,v)),fresnel=pow(1.-facing,3.);
  vec3 reflected=reflect(-v,n);
  float window=pow(max(0.,dot(reflected,light)),9.);
  float flash=pow(abs(dot(n,normalize(v+light))),44.);
  float glint=pow(max(0.,dot(reflect(-light,n),v)),52.);
  float flicker=pow(.5+.5*sin(TIME*TAU*floor(210.+facetNormal.w*123.)/210.+facetNormal.w*83.),36.);
  float cool=pow(max(0.,dot(reflected,normalize(vec3(.85,.2,.48)))),12.);
  vec3 base=theme>.5?mix(vec3(.27,.39,.68),vec3(.78,.55,1.),.5+.5*reflected.y):mix(vec3(.52,.34,.13),vec3(1.,.86,.48),clamp(.32+.65*reflected.y,0.,1.));
  base=mix(base,vec3(.77,.86,.91),cool*.65);
  vec3 bary=vec3(effectUV,1.-effectUV.x-effectUV.y);float edge=min(bary.x,min(bary.y,bary.z));
  float rim=1.-smoothstep(.012,.045,edge);
  rgb=mix(base,theme>.5?vec3(.96,.99,1.):vec3(1.,.98,.87),clamp(window+flash+glint*.9+flicker*flash*.75+rim*(.45+fresnel*.35),0.,1.));
  float crack=exp(-pow((effectUV.x-.31-effectUV.y*.23)*100.,2.))*smoothstep(.07,.19,edge);
  rgb=mix(rgb,vec3(1.,.95,.85),crack*.28);
  alpha=.52+window*.4+fresnel*.26+flash*.42+glint*.6+flicker*flash*.3+rim*.28;
  // A traveling frost boundary lights the newly forming facets, then fades
  // into the same permanent gold material without swapping particle actors.
  float frost=sin(crystalBirth*3.14159265);
  rgb=mix(rgb,vec3(.91,.98,1.),frost*(.34+rim*.52));
  alpha=min(1.,alpha+frost*.25);
 }else if(effectKind<4.5){
  // Broad, angular light flakes, distinct from the faceted crystal material.
  float silhouette=p.x*.72+p.y;
  float edge=1.-smoothstep(.72,1.,silhouette);
  float heart=exp(-dot(effectUV*vec2(1.4,1.),effectUV*vec2(1.4,1.))*3.);
  alpha=edge*(.60+.40*heart);
  rgb=mix(vec3(1.,.65,.18),vec3(1.,1.,.88),.48+.52*heart);
 }else{
  float spatial=dot(materialPos,vec3(.21,.29,.24));
  float drift=floor(EXTRA_ACTOR_UNIFORM1.w*16.+.5)/210.;
  float phase=spatial-TIME*EXTRA_ACTOR_UNIFORM1.w+.035*sin(TAU*(spatial*.8-TIME*drift));
  rgb=theme>.5?astral(phase):gold(phase);
  float core=exp(-p.y*p.y*85.),halo=exp(-p.y*p.y*13.);
  alpha=core*.98+halo*.36+exp(-p.y*p.y*5.)*.045;
  if(theme>.5){
   // Moving nebula filaments and sparse embedded stars, not a flat purple tint.
   float cloud=.5+.5*sin(spatial*38.+sin(spatial*17.-TIME*EXTRA_ACTOR_UNIFORM1.w*TAU)*1.4);
   rgb=mix(rgb,vec3(.19,.16,.44),.25*cloud*(1.-core));
   float sparkleRate=floor(EXTRA_ACTOR_UNIFORM1.w*79.+.5)/210.;
   float sparkle=pow(.5+.5*sin(spatial*119.-TIME*TAU*sparkleRate),32.);
   rgb=mix(rgb,vec3(.94,.96,1.),sparkle*.65*core);
  }
  rgb=mix(rgb,theme>.5?vec3(.91,.96,1.):vec3(1.,.97,.86),core*.42);
  if(effectKind>6.5){alpha=exp(-p.y*p.y*10.)*.65+core*.28;}
 }
 float coverage=clamp(alpha*effectTint.a,0.,1.);
#if !defined(SURVEY_GUIDE) && !defined(SURVEY_GLOW)
 // Write depth only for visible fragments so subsequently drawn water/leaves
 // cannot overwrite a closer crystal. Empty billboard pixels must never mask
 // the world or another effect with an invisible rectangular depth plate.
 if(coverage<.035)discard;
#endif
 gl_FragColor=vec4(rgb,coverage);
}
