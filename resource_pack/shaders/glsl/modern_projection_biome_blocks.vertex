// __multiversion__
// This signals the loading code to prepend either #version 100 or #version 300 es as apropriate.

// Match fragment varyings/uniforms and retain packed preview-depth precision.
precision highp float;
#include "vertexVersionCentroid.h"
#if __VERSION__ >= 300
	#ifndef BYPASS_PIXEL_SHADER
		_centroid out vec2 uv0;
		_centroid out vec2 uv1;
	#endif
#else
	#ifndef BYPASS_PIXEL_SHADER
		varying vec2 uv0;
		varying vec2 uv1;
	#endif
#endif

#ifndef BYPASS_PIXEL_SHADER
	varying vec4 color;
#endif

#ifdef FOG
	varying vec4 fogColor;
#endif
varying vec4 light;
varying highp float previewClip;
varying highp vec2 gridPosition;
varying highp float outlineHue;

// Client-only projection actors set this flag so their preview ignores
// time-of-day lighting and world fog while other actor block geometry keeps
// the native terrain appearance.
uniform highp vec4 EXTRA_ACTOR_UNIFORM4;
uniform float COMMON_BLOCK_GEO_FLOAT1_1;

#include "uniformWorldConstants.h"
#include "uniformPerFrameConstants.h"
#include "uniformShaderConstants.h"
#include "uniformRenderChunkConstants.h"
#include "uniformEntityConstants.h"

attribute POS4 POSITION;
attribute vec4 COLOR;
attribute vec2 TEXCOORD_0;
attribute vec2 TEXCOORD_1;

const float rA = 1.0;
const float rB = 1.0;
const vec3 UNIT_Y = vec3(0,1,0);
const float DIST_DESATURATION = 56.0 / 255.0; //WARNING this value is also hardcoded in the water color, don'tchange

#ifndef SEASONS
// Keep this predicate in sync with the fragment shader. The vanilla grass
// colormaps and overrides include yellow savanna and brown badlands colors.
// One continuous chroma range also preserves their biome-boundary blends
// and lighting-scaled colors; neutral vertex lighting remains excluded.
bool grassVertexTint(vec3 tint) {
    return tint.g > tint.r*0.85 && tint.g > tint.b*1.05;
}
#endif

void main()
{
    POS4 worldPos;
	POS4 pos = WORLDVIEWPROJ * POSITION;
	worldPos = pos;

    // PaperDoll scales XYZ together but retains a fixed orthographic depth
    // range. At close editing distances this clips otherwise visible faces.
    // Building tiles use one shared view-depth transform; unrelated UI models
    // retain the bounded per-control transform. Both are affine, preserving
    // interpolation. XY and perspective world rendering are untouched.
    bool preview = abs(PROJ[3][3]) > 0.5;
    float previewTag = floor(CURRENT_COLOR.r*255.0+0.5);
    outlineHue = 0.0;
    if (preview && previewTag >= 223.0 && previewTag <= 226.0) {
        // Separated source quads encode outline edges or work-grid lines.
        // Expand their centre lines in model space, then billboard the width
        // in native UI units, so every camera angle retains the same stroke.
        float index = floor((POSITION.x+1.1)/2.0);
        float along = POSITION.x+1.0-index*2.0;
        float across = POSITION.z+0.5;
        float axis = floor(index/4.0);
        float corner = mod(index,4.0);
        vec3 point = vec3(along-0.5, floor(corner/2.0)-0.5, mod(corner,2.0)-0.5);
        if (axis > 0.5 && axis < 1.5) point = point.yxz;
        if (axis > 1.5) point = point.yzx;
        float packet = floor(CURRENT_COLOR.g*524288.0+0.5);
        vec3 size = vec3(mod(packet,64.0), mod(floor(packet/64.0),128.0), floor(packet/8192.0))+1.0;
        vec3 centerLine = point*size;
        if (previewTag == 223.0) {
            axis = index < 65.0 ? 0.0 : 2.0;
            float coordinate = index < 65.0 ? index : index-65.0;
            if (coordinate > (axis < 0.5 ? size.z : size.x)) {
                gl_Position = vec4(0.0,0.0,2.0,1.0);
                return;
            }
            centerLine = axis < 0.5 ? vec3((along-0.5)*size.x,0.0,coordinate-size.z*0.5) :
                                     vec3(coordinate-size.x*0.5,0.0,(along-0.5)*size.z);
        }
        // The dyadic 24-bit packet is exact. Adding .5 above 2^23 would
        // round odd phases up, occasionally carrying into the clip depth.
        float state = floor(CURRENT_COLOR.b*16777216.0);
        float distance = (floor(state/256.0)-32768.0)/64.0;
        vec3 viewZ = vec3(WORLDVIEW[0][2], WORLDVIEW[1][2], WORLDVIEW[2][2]);
        previewClip = dot(normalize(viewZ),centerLine)+distance;
        outlineHue = dot(point+0.5,vec3(0.1875,0.3125,0.125))+mod(state,256.0)/256.0;
        vec2 line = WORLDVIEW[0].xy*size.x;
        if (axis > 0.5 && axis < 1.5) line = WORLDVIEW[1].xy*size.y;
        if (axis > 1.5) line = WORLDVIEW[2].xy*size.z;
        vec2 normal = vec2(-line.y,line.x)/max(length(line),0.00001);
        float thickness = (CURRENT_COLOR.r*255.0-previewTag)*8.0;
        vec4 viewPoint = WORLDVIEW*vec4(centerLine,1.0);
        // Extra triangle coverage survives low subpixel raster precision.
        // The fragment stage trims it to the same width as the work grid.
        float coverageWidth = thickness+0.25;
        viewPoint.xy += normal*across*coverageWidth;
        gl_Position = PROJ*viewPoint;
        // Editing outlines remain above the scene; work-grid strokes test
        // building depth. Hover still clips at the actual view-depth plane.
        if (previewTag == 223.0) {
            float centerDepth = PROJ[2][2]*(-350.0)+PROJ[3][2];
            gl_Position.z = (centerDepth+(previewClip+0.02)*PROJ[2][2]*0.04)/(1.0+abs(centerDepth));
        } else gl_Position.z = -0.999;
        gridPosition = vec2(across*coverageWidth,thickness*0.5);
        light = vec4(1.0);
        #ifndef BYPASS_PIXEL_SHADER
        uv0 = TEXCOORD_0;
        uv1 = TEXCOORD_1;
        color = vec4(1.0);
        #endif
        #ifdef FOG
        fogColor = vec4(0.0);
        #endif
        return;
    }
    previewClip = -1.0;
    if (preview) {
        float tag = floor(CURRENT_COLOR.r*255.0+0.5);
        bool buildingUI = tag >= 209.0 && tag <= 222.0;
        if (buildingUI) {
            // Each tile seeds CURRENT_COLOR immediately before its two model
            // buffers. Native layers stay fixed; RGB carries biome + signed
            // centre-to-view-plane distance. Alpha remains the workspace fade.
            float distance = (floor(CURRENT_COLOR.g*255.0+0.5)*256.0 +
                              floor(CURRENT_COLOR.b*255.0+0.5)-32768.0)/64.0;
            vec3 viewZ = vec3(WORLDVIEW[0][2], WORLDVIEW[1][2], WORLDVIEW[2][2]);
            previewClip = dot(normalize(viewZ), POSITION.xyz) + distance;
            // All tiles use ONE depth transform, independent of control order,
            // zoom or chunk boundaries. A larger toward-view distance is nearer.
            float centerDepth = PROJ[2][2]*(-350.0) + PROJ[3][2];
            pos.z = (centerDepth + previewClip*PROJ[2][2]*0.04) /
                    (1.0+abs(centerDepth));
        } else {
            float depthRange = 1.0 + abs(WORLDVIEWPROJ[3][2]) + 128.0 *
                (abs(WORLDVIEWPROJ[0][2]) + abs(WORLDVIEWPROJ[1][2]) + abs(WORLDVIEWPROJ[2][2]));
            float centerDepth = WORLDVIEWPROJ[3][2];
            float localDepth = (pos.z - centerDepth) / depthRange;
            pos.z = (centerDepth + localDepth * abs(PROJ[2][2]) * 0.25) /
                (1.0 + abs(centerDepth));
        }
    }
    gl_Position = pos;
    gridPosition = POSITION.xz;

    bool projectionWorld = !preview && abs(EXTRA_ACTOR_UNIFORM4.x - 19487.0) < 0.25;
    if (projectionWorld && abs(EXTRA_ACTOR_UNIFORM4.z) > 0.5) {
        float bank = COMMON_BLOCK_GEO_FLOAT1_1 < 0.5 ? 1.0 : 2.0;
        if (abs(bank-EXTRA_ACTOR_UNIFORM4.z) > 0.25)
            gl_Position = vec4(0.0, 0.0, 2.0, 1.0);
    }
    light = (preview || projectionWorld) ? vec4(1.0) : vec4(TILE_LIGHT_COLOR.xyz, 1.0);

#ifndef BYPASS_PIXEL_SHADER
    uv0 = TEXCOORD_0;
	uv1 = TEXCOORD_1;
	color = COLOR;
    // SEASONS encodes colormap UVs and tint weight, not an RGB color.
    // Clamping it as lighting changes both the biome and untinted textures.
    #ifndef SEASONS
    bool biomeVertex = grassVertexTint(COLOR.rgb);
    if (preview && !biomeVertex) color.rgb = max(color.rgb, vec3(0.55));
    #endif
#endif

///// find distance from the camera

#if defined(FOG) || defined(BLEND)
	#ifdef FANCY
		vec3 relPos = -worldPos.xyz;
		float cameraDepth = length(relPos);
	#else
		float cameraDepth = pos.z;
	#endif
#endif

///// apply fog

#ifdef FOG
	float len = cameraDepth / RENDER_DISTANCE;
	#ifdef ALLOW_FADE
		len += RENDER_CHUNK_FOG_ALPHA;
	#endif

    fogColor.rgb = FOG_COLOR.rgb;
	fogColor.a = projectionWorld ? 0.0 : clamp((len - FOG_CONTROL.x) / (FOG_CONTROL.y - FOG_CONTROL.x), 0.0, 1.0);
#endif

///// blended layer (mostly water) magic
#ifdef BLEND
	//Mega hack: only things that become opaque are allowed to have vertex-driven transparency in the Blended layer...
	//to fix this we'd need to find more space for a flag in the vertex format. color.a is the only unused part
	bool shouldBecomeOpaqueInTheDistance = color.a < 0.95;
	if(shouldBecomeOpaqueInTheDistance) {
		#ifdef FANCY  /////enhance water
			float cameraDist = cameraDepth / FAR_CHUNKS_DISTANCE;
			color = COLOR;
		#else
			// Completely insane, but if I don't have these two lines in here, the water doesn't render on a Nexus 6
			vec4 surfColor = vec4(color.rgb, 1.0);
			color = surfColor;
				
			vec3 relPos = -worldPos.xyz;
			float camDist = length(relPos);
			float cameraDist = camDist / FAR_CHUNKS_DISTANCE;
		#endif //FANCY
		
		float alphaFadeOut = clamp(cameraDist, 0.0, 1.0);
		color.a = mix(color.a, 1.0, alphaFadeOut);
	}
#endif

#ifndef BYPASS_PIXEL_SHADER
	#ifndef FOG
		// If the FOG_COLOR isn't used, the reflection on NVN fails to compute the correct size of the constant buffer as the uniform will also be gone from the reflection data
		color.rgb += FOG_COLOR.rgb * 0.000001;
	#endif
#endif
}
