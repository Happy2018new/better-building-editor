// __multiversion__
#include "entityVertexUtil.h"
varying highp vec3 skyRay;
varying highp vec3 gemNormal;
varying highp vec3 gemPosition;
varying highp vec3 gemLocalNormal;
void main(){
 vec4 p=POSITION,n=NORMAL;
 // Native boxes supply three rings per gem. Collapse the end rings into
 // sharp tips, retaining a proper solid faceted crystal rather than cubes.
#if !defined(STAFF_GRIP) && !defined(STAFF_GOLD_MOTE)
 float taper=max(.012,1.-abs(p.y)*.5);
 p.xz*=taper;
 if(abs(n.y)<.5)n=vec4(normalize(vec3(n.x,sign(p.y)*.5,n.z)),0.);
#endif
#ifdef USE_SKINNING
 #ifdef NETEASE_SKINNING
  mat4 bone=GetBoneMatForNetease(int(BONEID_0));p=bone*p;n=bone*n;
 #elif defined(LARGE_VERTEX_SHADER_UNIFORMS)
  p=BONES[int(BONEID_0)]*p;n=BONES[int(BONEID_0)]*n;
 #else
  p=BONE*p;n=BONE*n;
 #endif
#endif
 vec3 world=(WORLD*p).xyz;
 skyRay=world;
 gemNormal=normalize((WORLD*vec4(n.xyz,0.)).xyz);
 gemPosition=POSITION.xyz;
 gemLocalNormal=NORMAL.xyz;
 gl_Position=WORLDVIEWPROJ*p;
}
