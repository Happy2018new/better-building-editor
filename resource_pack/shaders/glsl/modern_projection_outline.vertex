// __multiversion__
#include "entityVertexUtil.h"

uniform highp vec4 EXTRA_ACTOR_UNIFORM1;
uniform highp vec4 EXTRA_ACTOR_UNIFORM2;
uniform highp vec4 EXTRA_ACTOR_UNIFORM3;
varying highp float spectrumHue;
#ifdef LUMINOUS_OUTLINE
varying highp vec3 outlinePosition;
varying highp vec3 railLocal;
#endif

void main() {
    POS4 position = POSITION;
    // Every wire cuboid has its endpoints at a corner of a centred unit box.
    // Move those corners to the requested size; scale thickness separately.
    // Bedrock entity vertices are in sixteenths of a block before WORLD.
    vec3 corner = sign(position.xyz) * 8.0;
    // Keep wire thickness independent of building dimensions (0.045 blocks).
    float wireScale = max(.5, EXTRA_ACTOR_UNIFORM3.y);
#ifdef LUMINOUS_OUTLINE
    // Gold/starry use the exact same 0.045-block solid rails and depth pass.
    // Their uniforms additionally encode theme, entrance and orbit settings.
    wireScale = max(.5, fract(EXTRA_ACTOR_UNIFORM3.z) * 10.);
    wireScale *= smoothstep(0., .85, EXTRA_ACTOR_UNIFORM3.x);
#endif
    position.xyz = corner * EXTRA_ACTOR_UNIFORM1.xyz + (position.xyz - corner) * wireScale;
    vec3 local = position.xyz / (EXTRA_ACTOR_UNIFORM1.xyz * 16.0) + vec3(0.5);
#ifdef LUMINOUS_OUTLINE
    outlinePosition = local * 2. - 1.;
    railLocal = POSITION.xyz / 16.;
#endif
    // A shared spatial field gives all edges the same color where they meet.
    spectrumHue = dot(local, vec3(0.31, 0.43, 0.26)) + TIME * EXTRA_ACTOR_UNIFORM1.w;
    // Expand in model coordinates BEFORE the native root-bone transform,
    // which includes a Y translation and axis inversion even without animation.
#ifdef USE_SKINNING
    #ifdef NETEASE_SKINNING
        position = GetBoneMatForNetease(int(BONEID_0)) * position;
    #elif defined(LARGE_VERTEX_SHADER_UNIFORMS)
        position = BONES[int(BONEID_0)] * position;
    #else
        position = BONE * position;
    #endif
#endif
    // A client actor is kept close to the camera to avoid native actor
    // frustum culling when the camera enters a large projection. EXTRA2 is
    // the world-space correction from that temporary actor position back to
    // the fixed projection centre.
    if (EXTRA_ACTOR_UNIFORM2.w > 0.5) {
        vec4 worldPosition = WORLD * position;
        worldPosition.xyz += EXTRA_ACTOR_UNIFORM2.xyz;
        gl_Position = VIEWPROJ * worldPosition;
    } else {
        gl_Position = WORLDVIEWPROJ * position;
    }
}
