// __multiversion__
#include "fragmentVersionCentroid.h"
#include "uniformPerFrameConstants.h"
varying highp vec3 surveyLocal;
varying highp vec3 surveySize;

float hash2(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
float noise2(vec2 p) {
    vec2 cell = floor(p);
    vec2 f = fract(p); f = f*f*(3.-2.*f);
    return mix(mix(hash2(cell),hash2(cell+vec2(1.,0.)),f.x),
               mix(hash2(cell+vec2(0.,1.)),hash2(cell+vec2(1.,1.)),f.x),f.y);
}
void main() {
#ifdef SURVEY_VEIL
    vec3 d = max(vec3(0.0), surveySize*.5-abs(surveyLocal));
    float edge = min(max(d.x,d.y),min(max(d.y,d.z),max(d.z,d.x)));
    // A faint white volume, with a soft pearlescent margin around its edges.
    float rim = exp(-edge*edge*160.);
    gl_FragColor = vec4(vec3(.94,.96,1.),.04+.035*rim);
#else
    vec3 p = surveyLocal;
    float s = p.x+p.y+p.z;
    // Curling, multi-scale nebula rather than a uniformly coloured tube.
    // Translating the field by ~1.7 blocks/s makes its motion readable.
    vec2 q = vec2(s*2.2-TIME*3.6,dot(p,vec3(47.,31.,53.))+TIME*.8);
    float warp = noise2(q*.45);
    float cloud = .65*noise2(q+warp*2.7)+.35*noise2(q*2.3-warp);
    // Deep indigo with fast lavender plasma running through a thin blue edge.
    vec3 nebula = mix(vec3(.30,.38,.78),vec3(.65,.72,1.),smoothstep(.13,.73,cloud));
    float plasma = pow(.5+.5*sin(s*5.2-TIME*10.5+warp*6.),6.);
    nebula = mix(nebula,vec3(.79,.52,1.),plasma*.65);
    vec2 starGrid = vec2(s*16.-TIME*10.,dot(p,vec3(83.,127.,101.)));
    vec2 cell = floor(starGrid);
    vec2 starPos = vec2(hash2(cell),hash2(cell+17.));
    float spark = exp(-dot(fract(starGrid)-starPos,fract(starGrid)-starPos)*65.)
                 *step(.77,hash2(cell+39.));
    gl_FragColor = vec4(mix(nebula,vec3(.86,.94,1.),spark*.85),1.);
#endif
}
