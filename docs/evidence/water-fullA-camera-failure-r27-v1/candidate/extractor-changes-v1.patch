+def components(mask):
+    bounds=mask.getbbox()
+    if bounds is None:
+        return [],{}
+    left,top,right,bottom=bounds
+    pixels=mask.load()
+    remaining={(x,y) for y in range(top,bottom) for x in range(left,right) if pixels[x,y]}
+    result=[]
+    labels={}
+    while remaining:
+        first=remaining.pop();pending=deque((first,));items={first}
+        while pending:
+            x,y=pending.popleft()
+            for point in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
+                if point in remaining:
+                    remaining.remove(point);items.add(point);pending.append(point)
+        index=len(result)
+        labels.update((point,index) for point in items)
+        result.append(items)
+    return result,labels
+
+def blend_supported(shown,hidden,foreground):
+    """Actual pixel must be a foreground/background mixture, never background.
+
+    Use the existing neutral channel tolerance (13), without broadening the
+    original neutral mask. The original >20 contribution gate is independent.
+    """
+    vector=[hidden[i]-foreground[i] for i in range(3)]
+    denominator=sum(value*value for value in vector)
+    if not denominator:
+        return False
+    alpha=sum((shown[i]-foreground[i])*vector[i] for i in range(3))/float(denominator)
+    return (0.<alpha<1. and
+        max(abs(shown[i]-(foreground[i]+alpha*vector[i])) for i in range(3))<13.)
+
+def stone_signal(shown_path,hidden_path,observations=None):
+    with Image.open(shown_path) as image:
+        shown=image.convert('RGB')
+    with Image.open(hidden_path) as image:
+        hidden=image.convert('RGB')
+    assert shown.size==hidden.size,'The viewport changed during a visibility capture'
+    red,green,blue=shown.split()
+    spread=original.maximum(Image.merge('RGB',(ImageChops.difference(red,green),
+        ImageChops.difference(red,blue),ImageChops.difference(green,blue))))
+    neutral=spread.point(lambda value:255 if value<13 else 0)
+    brightness=red.point(lambda value:255 if value>50 else 0)
+    center=Image.new('L',shown.size)
+    ImageDraw.Draw(center).rectangle((shown.width*.3,shown.height*.25,shown.width*.7,shown.height*.75),fill=255)
+    contribution=original.maximum(ImageChops.difference(shown,hidden)).point(lambda value:255 if value>20 else 0)
+    mask=ImageChops.multiply(ImageChops.multiply(ImageChops.multiply(neutral,brightness),center),contribution)
+    groups,labels=components(mask)
+    facts={'original_component_sizes':sorted(map(len,groups),reverse=True),'bridged_pixels':[],
+        'color_tests_unchanged':True,'expected_silhouette_used':False}
+    if observations is not None:
+        observations.update(facts)
+    assert groups,'The native calibration cube is invisible'
+    if len(groups)>1:
+        assert len(groups)==2,'More than two neutral components; refuse unrelated visible objects'
+        # A bridge can span exactly one missing pixel between original pixels
+        # from different components along one row or column. No dilation of
+        # arbitrary outlines or additions taken from a predicted hull occur.
+        candidates={}
+        for x,y in labels:
+            for dx,dy in ((1,0),(0,1)):
+                other=(x+2*dx,y+2*dy)
+                gap=(x+dx,y+dy)
+                if other in labels and labels[other]!=labels[(x,y)] and gap not in labels:
+                    candidates.setdefault(gap,[]).append(((x,y),other))
+        assert candidates,'Independent neutral components have no one-pixel contact'
+        xs={point[0] for point in candidates};ys={point[1] for point in candidates}
+        assert len(xs)==1 or len(ys)==1,'A permitted seam is one straight raster row or column'
+        positions=sorted(ys if len(xs)==1 else xs)
+        assert positions==list(range(positions[0],positions[-1]+1)),'The actual seam must be continuous'
+        assert len(positions)>1,'A single contact pixel does not prove a face seam'
+        for point,opposites in candidates.items():
+            assert (contribution.getpixel(point)==255 and brightness.getpixel(point)==255), \
+                'Seam has no actual bright foreground contribution'
+            assert any(blend_supported(shown.getpixel(point),hidden.getpixel(point),shown.getpixel(adjacent))
+                for endpoints in opposites for adjacent in endpoints), \
+                'Seam pixel is not an actual neighboring neutral/background blend'
+        for point in candidates:
+            mask.putpixel(point,255)
+        merged,unused=components(mask)
+        assert len(merged)==1,'One-pixel support did not connect the same two components'
+        facts['bridged_pixels'][:]=sorted(candidates)
+    # The original hole-fill and one-pixel morphology remain unchanged.
+    outline=original.fill_enclosed_holes(mask).filter(ImageFilter.MedianFilter(3))
+    outline=outline.filter(ImageFilter.MinFilter(3)).filter(ImageFilter.MaxFilter(3))
+    assert ImageChops.multiply(outline,contribution).histogram()[255]>=1000,'Native cube contribution is not observable'
+    if observations is not None:
+        observations.update(facts)
