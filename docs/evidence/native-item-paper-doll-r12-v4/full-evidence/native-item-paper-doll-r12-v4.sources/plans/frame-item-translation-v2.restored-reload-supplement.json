              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true
            }
          },
          {
            "name": "get_latest_logs",
            "description": "Returns the most recent game log entries.\n\nParameters:\n- max_count: Maximum number of log entries to return\n- order: \"asc\" for oldest to newest\n         \"desc\" for newest to oldest\n",
            "inputSchema": {
              "properties": {
                "max_count": {
                  "type": "number",
                  "description": "Maximum number of log entries to return"
                },
                "order": {
                  "type": "string",
                  "description": "Order of logs (asc or desc)"
                }
              },
              "type": "object"
            },
