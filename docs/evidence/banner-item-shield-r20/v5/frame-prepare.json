  "code": "import json, sys, math\nimport mod.server.extraServerApi as api\nfactory = api.GetEngineCompFactory()\nplayer = api.GetPlayerList()[0]\ninfo = factory.CreateBlockInfo(player)\nitems = factory.CreateItem(player)\ndimension = factory.CreateDimension(player).GetEntityDimensionId()\nassert dimension == 0\nassert not hasattr(sys, '_shield_banner_frame_r20')\nfoot = factory.CreatePos(player).GetFootPos()\norigin = (int(math.floor(foot[0])) + 2, int(math.floor(foot[1])) + 2,\n          int(math.floor(foot[2])) + 3)\ninventory_type = api.GetMinecraftEnum().ItemPosType.INVENTORY\nsaved = {'journal': [], 'inventory': items.GetPlayerItem(inventory_type, 35, True),\n         'origin': origin, 'rows': []}\nsys._shield_banner_frame_r20 = saved\npatterns = [{'Color': color, 'Pattern': pattern}\n            for color, pattern in ((1, 'bo'), (14, 'cr'), (11, 'mc'))]\nfor index, (label, user_data) in enumerate((('plain', None), ('multilayer', {'Patterns': patterns}))):\n    pos = (origin[0] + index * 2, origin[1], origin[2])\n    support = (pos[0], pos[1], pos[2] + 1)\n    for target in (support, pos):\n        before = info.GetBlockNew(target, dimension)\n        assert before and before['name'] == 'minecraft:air', (target, before)\n        saved['journal'].append({'pos': target, 'block': before,\n                                 'nbt': info.GetBlockEntityData(dimension, target)})\n    info.SetBlockNew(support, {'name': 'minecraft:cyan_concrete', 'aux': 0}, 0, dimension, True, True)\n    assert items.SetInvItemNum(35, 0)\n    assert items.SpawnItemToPlayerInv({'itemName': 'minecraft:frame', 'count': 1, 'auxValue': 0}, player, 35)\n    assert info.PlayerUseItemToPos(support, inventory_type, 35, 2)\n    assert info.GetBlockNew(pos, dimension)['name'] == 'minecraft:frame'\n    assert items.SetInvItemNum(35, 0)\n    item = {'itemName': 'minecraft:banner', 'auxValue': 4, 'count': 1}\n    if user_data:\n        item['userData'] = user_data\n    assert items.SpawnItemToPlayerInv(item, player, 35)\n    readback = items.GetPlayerItem(inventory_type, 35, True)\n    assert info.PlayerUseItemToPos(pos, inventory_type, 35, 2)\n    actual_item = factory.CreateBlockEntity(factory.GetLevelId() if hasattr(factory, 'GetLevelId') else api.GetLevelId()).GetFrameItem(pos, dimension)\n    saved['rows'].append({'label': label, 'pos': pos, 'support': support,\n                          'inventory': readback, 'item_api': actual_item,\n                          'block': info.GetBlockNew(pos, dimension),\n                          'nbt': info.GetBlockEntityData(dimension, pos)})\nassert items.SetInvItemNum(35, 0)\nif saved['inventory']:\n    assert items.SpawnItemToPlayerInv(saved['inventory'], player, 35)\n_result = json.dumps({'origin': origin, 'rows': saved['rows']})\n",
