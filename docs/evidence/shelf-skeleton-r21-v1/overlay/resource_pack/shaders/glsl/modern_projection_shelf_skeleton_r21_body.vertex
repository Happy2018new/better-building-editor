// __multiversion__
precision highp float;
#include "neteaseModelVertexUtil.h"
#include "uniformExtraVectorConstants.h"
#include "uniformShaderConstants.h"
#ifndef MODERN_PROJECTION_LIQUID_PREVIEW_DEPTH_H
#define MODERN_PROJECTION_LIQUID_PREVIEW_DEPTH_H

#include "uniformShaderConstants.h"

// The liquid caller supplies decoded coordinates around its four-cell centre.
void liquidApplyPreviewDepth(vec3 point, float distance, inout vec4 projected, out float clip) {
    vec3 viewZ = vec3(WORLDVIEW[0][2], WORLDVIEW[1][2], WORLDVIEW[2][2]);
    clip = dot(normalize(viewZ), point) + distance;
    float centerDepth = PROJ[2][2] * (-350.0) + PROJ[3][2];
    projected.z = (centerDepth + clip * PROJ[2][2] * 0.04) / (1.0 + abs(centerDepth));
}

void liquidUniformPreviewDepth(vec3 point, float depthCode, inout vec4 projected, out float clip) {
    clip = -1.0;
    if (abs(PROJ[3][3]) <= 0.5 || mod(depthCode,256.0) != 134.0) return;
    float distance = (floor(depthCode / 256.0) - 32768.0) / 64.0;
    liquidApplyPreviewDepth(point, distance, projected, clip);
}

// Retain the image-packet diagnostic path for independent binding controls.
void liquidPreviewDepth(vec3 point, inout vec4 projected, out float clip) {
    clip = -1.0;
    float tag = floor(CURRENT_COLOR.r * 255.0 + 0.5);
    if (abs(PROJ[3][3]) <= 0.5 || tag < 209.0 || tag > 222.0) return;
    bool layoutPacket = fract(CURRENT_COLOR.r * 255.0) > 0.125;
    float distance = (floor(CURRENT_COLOR.g * 255.0 + 0.5) * 256.0 +
                      floor(CURRENT_COLOR.b * 255.0 + 0.5) - 32768.0) / 64.0;
    if (layoutPacket) distance = (floor(CURRENT_COLOR.b * 65536.0 + 0.5) - 32768.0) / 64.0;
    liquidApplyPreviewDepth(point, distance, projected, clip);
}

#endif

varying highp vec2 shelfUv;
varying highp vec3 shelfDocumentNormal;
varying highp vec3 shelfWorldNormal;
varying highp float shelfIntensity;
varying highp float shelfVisible;
varying highp float shelfClip;
vec3 shelfTurn(vec3 point, float direction) {
    point.xz=mat2(cos(direction),sin(direction),-sin(direction),cos(direction))*point.xz;
    return point;
}
float shelfAxisIntensity(vec3 normal, float lightDirection) {
    vec3 N=normalize(normal);
    N.y*=lightDirection;
    return (1.0+N.y)*0.275-N.x*N.x*0.1+N.z*N.z*0.1+0.45;
}

void main() {
    float slot=floor(POSITION.z/4.0);
    float code=EXTRA_VECTOR1.x;
    if(slot>0.5) code=EXTRA_VECTOR1.y;
    if(slot>1.5) code=EXTRA_VECTOR1.z;
    if(slot>2.5) code=EXTRA_VECTOR1.w;
    float address=mod(code,64.0);
    float direction=floor(code/4096.0)*6.283185307179586/256.0;
    bool tagged=abs(EXTRA_VECTOR4.x-39686.0)<0.25 || mod(EXTRA_VECTOR4.x,256.0)==134.0;
    shelfVisible=tagged && mod(floor(code/64.0),64.0)>0.5 ? 1.0 : 0.0;
    vec3 point=shelfTurn(vec3(POSITION.x,POSITION.y,mod(POSITION.z,4.0)-1.0),direction);
    shelfDocumentNormal=shelfTurn(NORMAL.xyz,direction);
    vec3 cell=vec3(mod(address,4.0),floor(address/16.0),mod(floor(address/4.0),4.0));
    vec3 localPoint=cell+vec3(0.5,0.0,0.5)+point-vec3(2.0);
    vec4 entityPoint=vec4(localPoint,1.0);
    vec4 entityNormal=vec4(shelfDocumentNormal,0.0);
    entityPoint=vec4(-localPoint.x,-localPoint.z+1.5,-localPoint.y,1.0);
    
    shelfWorldNormal=shelfDocumentNormal;
    gl_Position=WORLDVIEWPROJ*entityPoint;
    shelfClip=-1.0;
    liquidUniformPreviewDepth(vec3(-localPoint.x,-localPoint.z,-localPoint.y),EXTRA_VECTOR4.x,gl_Position,shelfClip);
    shelfUv=TEXCOORD_0;
    shelfIntensity=shelfAxisIntensity(shelfDocumentNormal,TILE_LIGHT_COLOR.w);
    gl_PointSize=1.0;
}
