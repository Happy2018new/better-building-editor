diff --git a/tools/mcdk/src/game_process.cpp b/tools/mcdk/src/game_process.cpp
index 4eeee87..2dfd7fe 100644
--- a/tools/mcdk/src/game_process.cpp
+++ b/tools/mcdk/src/game_process.cpp
@@ -64,0 +65 @@
+#include <mcdk/focus_guard.hpp>
@@ -679,0 +681,2 @@ void mcdk::launchGameExe(
+    si.dwFlags |= STARTF_USESHOWWINDOW;
+    si.wShowWindow = SW_SHOWNOACTIVATE;
@@ -770 +773,5 @@ void mcdk::launchGameExe(
-    const DWORD creationFlags = CREATE_UNICODE_ENVIRONMENT | (useSafaiaLogs ? CREATE_SUSPENDED : 0);
+    wchar_t focusGuardPath[32768] = {};
+    const DWORD focusGuardLength = GetEnvironmentVariableW(L"MCDK_NOACTIVATE_DLL", focusGuardPath, 32768);
